<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <IsPackable>false</IsPackable>
    <!-- Принудительное применение требований к коду: как в основном проекте -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- CA1707: подчёркивания в именах тестовых методов — принятый для xUnit
         формат "Метод_Сценарий_Ожидание" (см. существующие тесты проекта);
         переименование сотен тестов против конвенции ничего не улучшает -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
    <!-- Позволяет собирать Windows-ориентированный проект (в т.ч. в CI на Linux);
         на Windows свойство не влияет на результат сборки -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <!-- Доступ к типам ASP.NET Core (HttpContext, ApplicationBuilder) для тестов middleware -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WebShelf\WebShelf.csproj" />
  </ItemGroup>

</Project>
