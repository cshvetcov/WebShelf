### Настройки для интеграции с ActiveDirectory 
### Необходимо заполнить следующие поля для корректной работы интеграции с ActiveDirectory

### Настройки сети
# scheme: http или https (без учёта регистра)
scheme=https
# port: порт, на котором слушает приложение (1–65535)
port=

### Настройки TLS-сертификата (используются только при scheme=https)
# Путь к PFX-сертификату сервера, например C:\certs\webshelf.pfx.
# Относительный путь ищется рядом с приложением. Обязателен при scheme=https.
certpath=
# Пароль PFX-файла в открытом виде (очищается автоматически).
# Для PFX без пароля оставьте поле пустым.
certpass=
# Пароль PFX-файла, зашифрованный мастер-ключом (заполняется автоматически)
scertpass=

### Настройки для управления доменом
# Имя домена ActiveDirectory (например, mydomain.local)
domainname=
# Имя серверной учетной записи, которая имеет права на чтение и запись в ActiveDirectory (очищается автоматически)
domainuser=
# Пароль от серверной учетной записи, которая имеет права на чтение и запись в ActiveDirectory (очищается автоматически)
domainpass=
# Имя серверной учетной записи, зашифрованное мастер-ключом (заполняется автоматически)
sdomainuser=
# Пароль серверной учетной записи, зашифрованный мастер-ключом (заполняется автоматически)
sdomainpass=

### Настройки базы данных PostgreSQL
# Хост сервера PostgreSQL (имя или IP)
dbhost=
# Порт PostgreSQL (1–65535, по умолчанию 5432)
dbport=5432
# Имя базы данных
dbname=
# Режим SSL: Disable, Allow, Prefer, Require, VerifyCA, VerifyFull (по умолчанию Require)
dbsslmode=Require
# Имя сервисной учётной записи БД (очищается автоматически после шифрования)
dbuser=
# Пароль сервисной учётной записи БД (очищается автоматически после шифрования)
dbpass=
# Имя сервисной учётной записи БД, зашифрованное мастер-ключом (заполняется автоматически)
sdbuser=
# Пароль сервисной учётной записи БД, зашифрованный мастер-ключом (заполняется автоматически)
sdbpass=

### Настройки схемы БД (каркас, дампы, автосброс)
# Имя схемы PostgreSQL для данных WebShelf (строчные латинские буквы, цифры,
# подчёркивания; по умолчанию webshelf)
dbschema=webshelf
# Путь к SQL-файлу-каркасу структуры БД. Относительный путь — от каталога
# приложения. По умолчанию db/webshelf_skeleton.sql
dbskeletonpath=db/webshelf_skeleton.sql
# Каталог дампов БД. Относительный путь — от каталога приложения. Каталог не должен
# находиться внутри wwwroot — дампы недоступны по web. По умолчанию Data/DbDumps
dbdumpspath=Data/DbDumps
# Срок хранения дампов, дней (1–3650; вне диапазона, не число или не задано — 90).
# Дамп с максимальной датой создания не удаляется никогда.
dbdumpretentiondays=90
# Автоматическое приведение структуры БД к каркасу при несовпадении на старте.
# true — при расхождении сначала создаётся дамп (если схема не пуста; ошибка дампа
# блокирует запуск), затем выполняется обновление структуры с сохранением данных
# по возможности; false (по умолчанию, безопасное значение) — расхождение
# блокирует запуск приложения (fail-fast), данные не затрагиваются.
# Это единственное место системы, которое может изменить данные без участия
# человека: включайте только осознанно.
dbautoschemareset=false

### Настройки ролевой модели
# TTL кэша роли пользователя, секунды. Допустимый диапазон 10–300;
# вне диапазона, не число или не задано — принимается 60.
rolettl=
# Интервал фонового опроса ролевых групп AD, секунды. Допустимый диапазон 10–300;
# вне диапазона, не число или не задано — принимается 30. Смена роли доезжает
# до открытых сессий не позже этого интервала.
rolepoll=

### Настройки обработки файлов cookie
# Показ баннера согласия на обработку файлов cookie. false (по умолчанию,
# безопасное значение) — баннер выключен: система использует только технически
# необходимые cookie (аутентификация и защита от CSRF), для которых отдельное
# согласие не требуется. true — баннер согласия показывается пользователям,
# у которых нет сохранённого решения (решение хранится в localStorage браузера
# и на сервер не передаётся). Требуется при появлении необязательных cookie
# (аналитика, маркетинг и т.п.) — см. WebShelfDocs/Решения в проекте/Обработка cookie.md.
# Некорректное значение — как false.
cookieconsent=false

### Примечание
# InstanceId (ULID) генерируется автоматически при первом запуске (Release) и хранится в
# HKEY_CURRENT_USER\Software\WebShelf\Encryption (значение InstanceId) под защитой DPAPI.
# В Debug-сборке InstanceId фиксирован (26 нулей) и один и тот же на всех компьютерах:
# группы для отладки имеют вид WebShelf-000000000000-*.
# Пользователи WebShelf должны состоять в группе AD:
#   WebShelf-{12 символов InstanceId в нижнем регистре}-Users
# Ролевые группы создаются приложением автоматически при старте:
#   WebShelf-{id}-Administrator … WebShelf-{id}-Customer
# Гость — отдельной группы не имеет: это пользователь без единой ролевой группы.
# Текущая роль пользователя отображается на ленте в квадратных скобках
# между логином и кнопкой выхода: ivanov [Администратор] Выйти.
# Текущий InstanceIdShort смотрите в логе при старте приложения.
