### Настройки для интеграции с ActiveDirectory 
### Необходимо заполнить следующие поля для корректной работы интеграции с ActiveDirectory

### Настройки сети
# scheme: http или https (без учёта регистра)
scheme=https
# port: порт, на котором слушает приложение (1–65535)
port=

### Идентификатор ActiveDirectory
# GUID (Globally Unique Identifier) домена используемый для идентификации объектов ActiveDirectory
# как пренадлежащих к WebShelf.
guid=

### Настройки для управления доменом
# Имя домена ActiveDirectory (например, mydomain.local)
domainname=
# Имя серверной учетной записи, которая имеет права на чтение и запись в ActiveDirectory
domainuser=
# Пароль от серверной учетной записи, которая имеет права на чтение и запись в ActiveDirectory
domainpass=
# Имя серверной учетной записи, которая имеет права на чтение и запись в ActiveDirectory зашифрованное мастер ключом (заполняется автоматически)
sdomainuser=
# Пароль от серверной учетной записи, которая имеет права на чтение и запись в ActiveDirectory зашифрованное мастер ключом (заполняется автоматически)
sdomainpass=