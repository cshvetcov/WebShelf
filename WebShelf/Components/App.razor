@using Microsoft.AspNetCore.Antiforgery
@using Microsoft.AspNetCore.Http
@using Serilog
@inject IAntiforgery Antiforgery
@inject IHttpContextAccessor HttpContextAccessor

<!DOCTYPE html>
<html lang="ru">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["css/window.css"]" />
    <link rel="stylesheet" href="@Assets["css/ribbon.css"]" />
    <link rel="stylesheet" href="@Assets["WebShelf.styles.css"]" />
    @* Antiforgery-токен для JS-запросов (logout): считывается в ribbon.js *@
    <meta name="ws-antiforgery-token" content="@antiforgeryToken" />
    <ImportMap />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <ReconnectModal />
    <script src="@Assets["js/window.js"]"></script>
    <script src="@Assets["js/ribbon.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    private const string ClassName = "WebShelf.Components.App";

    /// <summary>
    /// Antiforgery-токен текущего запроса; доступен JS через meta-тег
    /// ws-antiforgery-token (используется при выходе).
    /// </summary>
    private string antiforgeryToken = string.Empty;

    /// <summary>
    /// Корневой компонент рендерится в рамках HTTP-запроса:
    /// генерирует antiforgery-токен и сохраняет его (cookie + meta-тег).
    /// </summary>
    protected override void OnInitialized()
    {
        const string method = nameof(OnInitialized);

        try
        {
            HttpContext? http = HttpContextAccessor.HttpContext;

            if (http is not null)
            {
                AntiforgeryTokenSet tokens = Antiforgery.GetAndStoreTokens(http);
                antiforgeryToken = tokens.RequestToken ?? string.Empty;
            }
        }
        catch (Exception ex)
        {
            Log.Error(ex, "Не удалось получить antiforgery-токен. Class={Class}, Method={Method}", ClassName, method);
        }
    }
}
