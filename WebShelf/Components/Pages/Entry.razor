@page "/entry"
@rendermode InteractiveServer
@implements IAsyncDisposable

@using Microsoft.AspNetCore.Antiforgery
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.Extensions.Primitives
@using WebShelf.Classes.Service
@using WebShelf.Components.Shared
@using Serilog

@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject IAntiforgery Antiforgery
@inject IHttpContextAccessor HttpContextAccessor
@inject IJSRuntime Js
@inject LoginGuard LoginGuard
@inject RegistrationPermitChecker PermitChecker
@inject PermitActivationGuard PermitGuard

<PageTitle>Вход в систему WebShelf</PageTitle>

@* Заголовок первого уровня для FocusOnNavigate и скринридеров *@
<h1 class="ws-visually-hidden">Вход в систему</h1>

@* Окна страницы /entry показываются по очереди: «Вход в систему»,
   «Активация разрешения» и «Подача заявки на регистрацию» — переключаются
   кнопкой «Зарегистрироваться», кнопкой «Продолжить» (проверка пермита в БД)
   и закрытием окон. Фон страницы (body.ws-window-page) ведёт
   сама страница (см. OnAfterRenderAsync/DisposeAsync): при смене окон
   DisposeAsync старого окна может выполниться после первого рендера
   нового, поэтому окна рендерятся с ApplyPageBackground=false. *@
@if (currentWindow == EntryWindow.Login)
{
    <AppWindow Title="Вход в систему — WebShelf"
               IconText="WS"
               CanClose="false"
               CloseBubbleText="Это окно не может быть закрыто"
               ApplyPageBackground="false"
               MaxWidth="420px">

    <form method="post" action="/account/login" autocomplete="on">
        @* CSRF-токен: поле обязательно. Blazor не подставляет токен автоматически
           в <form> внутри интерактивных компонентов — без этого поля вход невозможен.
           Значение — пара к cookie WebShelf.Antiforgery текущего запроса. *@
        <input type="hidden" name="__RequestVerificationToken" value="@antiforgeryToken" />

        @* Исходный путь пользователя: заполняется из query ReturnUrl, который кладёт
           cookie-аутентификация при [Authorize]-редиректе с защищённой страницы. *@
        <input type="hidden" name="returnUrl" value="@returnUrl" />

        <div class="ws-form-group">
            <label for="username">Имя пользователя (AD)</label>
            <div class="ws-input-wrapper">
                <input type="text"
                       id="username"
                       name="username"
                       placeholder="Логин"
                       required
                       autofocus
                       autocomplete="username"
                       disabled="@isLocked" />
            </div>
        </div>

        <div class="ws-form-group">
            <label for="password">Пароль</label>
            <div class="ws-input-wrapper">
                <input type="password"
                       id="password"
                       name="password"
                       placeholder="Пароль"
                       required
                       autocomplete="current-password"
                       disabled="@isLocked" />
                <button type="button"
                        class="ws-toggle-password ws-hidden-eye"
                        aria-label="Показать пароль"
                        title="Показать / скрыть пароль"
                        disabled="@isLocked">
                    👁
                </button>
            </div>
        </div>

        <div class="ws-form-check">
            <input type="checkbox"
                   name="rememberMe"
                   value="true"
                   id="rememberMe"
                   disabled="@isLocked" />
            <label for="rememberMe">Запомнить меня</label>
        </div>

        <button type="submit" class="ws-btn-primary" disabled="@isLocked">
            @(isLocked ? "Вход временно заблокирован" : "Войти")
        </button>

        @* type="button": форма POST-ит на /account/login, клик не должен её отправлять.
           Кнопка просто открывает окно «Активация разрешения» и ничего
           не блокирует: неудачные проверки пермита обрабатываются в самом
           окне активации (сообщение + блокировка с обратным отсчётом),
           форма входа не затрагивается *@
        <button type="button" class="ws-btn-secondary" @onclick="OpenPermitActivation">Зарегистрироваться</button>

        @if (isLocked)
        {
            <div class="ws-message ws-message-lockout" role="alert">
                Слишком много неудачных попыток входа.
                Повторите через <strong>@lockoutSeconds</strong> с.
            </div>
        }
        else if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="ws-message ws-message-error" role="alert">@errorMessage</div>
        }
    </form>
</AppWindow>
}
else if (currentWindow == EntryWindow.PermitActivation)
{
    @* Окно «Активация разрешения»: визуально повторяет окно входа (тот же AppWindow
       и стили window.css). Закрытие кнопкой «×» возвращает на окно входа через OnClose.
       Кнопка «Продолжить» проверяет пермит в БД (RegistrationPermitChecker):
       пермит найден и счётчик регистраций больше нуля — открывается окно подачи
       заявки; неверный или исчерпанный пермит оставляет окно открытым — поведение
       как при неверной паре логин/пароль на форме входа, но блокировка с обратным
       отсчётом включается уже после первой неудачной попытки. Красное сообщение
       о неверном пермите не показывается: его заменяет оранжевый блок с таймером
       под кнопкой (оформление как на форме входа). Длительность и момент окончания
       блокировки хранит серверный PermitActivationGuard (первая неудача — 15 с,
       каждая следующая вдвое дольше, до предела 15 минут): обновление страницы
       и переоткрытие окна не сбрасывают отсчёт. *@
    <AppWindow Title="Активация разрешения — WebShelf"
               IconText="WS"
               CanClose="true"
               OnClose="ClosePermitActivation"
               ApplyPageBackground="false"
               MaxWidth="420px">
        <div class="ws-form-group">
            <label for="permit">Пермит</label>
            <div class="ws-input-wrapper">
                <input type="text"
                       id="permit"
                       placeholder="Введите ключ разрешения"
                       required
                       autocomplete="off"
                       disabled="@(isCheckingPermit || permitLockout.IsLocked)"
                       @bind="permitValue"
                       @bind:event="oninput" />
            </div>
        </div>

        <button type="button" class="ws-btn-primary" @onclick="SubmitPermitAsync" disabled="@(isCheckingPermit || permitLockout.IsLocked)">
            @(isCheckingPermit
                ? "Проверка пермита..."
                : permitLockout.IsLocked ? "Активация временно заблокирована" : "Продолжить")
        </button>

        @* Блокировка после неудачной проверки пермита: оранжевый блок с остатком
           секунд ПОД кнопкой — как на форме входа. Красное сообщение о неверном
           пермите не выводится: таймер включается уже после первой неудачной
           попытки и сам объясняет причину. Отсчёт переживает обновление страницы —
           состояние хранит серверный PermitActivationGuard *@
        @if (permitLockout.IsLocked)
        {
            <div class="ws-message ws-message-lockout" role="alert">
                Повторите попытку активации через <strong>@permitLockout.RemainingSeconds</strong> с.
            </div>
        }
        else if (!string.IsNullOrEmpty(permitErrorMessage))
        {
            @* Сообщение о пустом вводе или ошибке сервера (без блокировки) *@
            <div class="ws-message ws-message-error" role="alert">@permitErrorMessage</div>
        }
    </AppWindow>
}
else
{
    @* Окно «Подача заявки на регистрацию»: открывается после успешной проверки
       пермита (найден в БД, счётчик регистраций больше нуля). Закрытие кнопкой
       «×» возвращает на окно входа (не в окно активации). Форма — компонент
       RegistrationApplicationForm; состояние формы сбрасывается закрытием
       окна (компонент размонтируется). Проверенный пермит передаётся форме
       параметром — он списывается (счётчик уменьшается на 1) только при
       успешной подаче заявки. *@
    <AppWindow Title="Подача заявки на регистрацию — WebShelf"
               IconText="WS"
               CanClose="true"
               OnClose="CloseRegistrationApplication"
               ApplyPageBackground="false"
               MaxWidth="420px">
        <RegistrationApplicationForm Permit="activePermit" />
    </AppWindow>
}

@code {
    private const string ClassName = "WebShelf.Components.Pages.Entry";

    private string errorMessage = string.Empty;
    private string antiforgeryToken = string.Empty;
    private string returnUrl = string.Empty;

    /// <summary>
    /// Окно страницы /entry, показываемое в текущий момент.
    /// Окна сменяют друг друга: на странице всегда ровно одно окно.
    /// </summary>
    private enum EntryWindow
    {
        /// <summary>Окно «Вход в систему» (форма входа).</summary>
        Login,

        /// <summary>Окно «Активация разрешения» (ввод пермита).</summary>
        PermitActivation,

        /// <summary>Окно «Подача заявки на регистрацию» (анкета кандидата).</summary>
        RegistrationApplication
    }

    /// <summary>
    /// Текущее окно страницы /entry; по умолчанию — окно «Вход в систему».
    /// </summary>
    private EntryWindow currentWindow = EntryWindow.Login;

    /// <summary>
    /// Значение поля «Пермит». Не сохраняется при смене окон и после проверки:
    /// возврат на окно входа и обратно, а также нажатие «Продолжить»
    /// сбрасывают ввод.
    /// </summary>
    private string permitValue = string.Empty;

    /// <summary>
    /// Проверенный пермит, по которому открыто окно «Подача заявки
    /// на регистрацию»: заполняется после успешной проверки в БД
    /// (найден, счётчик больше нуля) и передаётся форме параметром — счётчик
    /// уменьшается на 1 только при успешной подаче заявки (не при открытии
    /// формы: пермит нельзя «сжечь», закрыв окно без отправки). Сбрасывается
    /// закрытием окна заявки. Секретный код: в логи не попадает ни при каких
    /// условиях (правило маскировки).
    /// </summary>
    private string activePermit = string.Empty;

    /// <summary>
    /// Сообщение об ошибке проверки пермита: пустой ввод или ошибка сервера
    /// (показывается в окне активации; пустое — ошибки нет). Неверный пермит
    /// сообщения не даёт — его заменяет блокировка с таймером.
    /// </summary>
    private string permitErrorMessage = string.Empty;

    /// <summary>
    /// true — выполняется проверка пермита в БД: поле и кнопка «Продолжить»
    /// заблокированы, повторный запуск проверки исключён.
    /// </summary>
    private bool isCheckingPermit;

    /// <summary>
    /// Отображаемый остаток блокировки окна «Активация разрешения»
    /// (CountdownLockout). Длительность и момент окончания хранит серверный
    /// PermitActivationGuard: первая неудачная проверка пермита блокирует окно
    /// на 15 с, каждая следующая удваивает длительность (до предела 15 минут);
    /// обновление страницы не сбрасывает отсчёт. Оформление — как у блокировки
    /// формы входа: поле и кнопка «Продолжить» заблокированы, под кнопкой —
    /// оранжевый блок ws-message-lockout с остатком секунд.
    /// </summary>
    private readonly CountdownLockout permitLockout = new();

    /// <summary>
    /// IP-адрес клиента для учёта блокировки активации разрешения
    /// (PermitActivationGuard): берётся из запроса цепи Blazor (как для
    /// LoginGuard в OnInitializedAsync); при недоступности — «unknown».
    /// </summary>
    private string ClientIp =>
        HttpContextAccessor.HttpContext?.Connection.RemoteIpAddress?.ToString() ?? "unknown";

    /// <summary>
    /// Таймер обратного отсчёта блокировки окна «Активация разрешения».
    /// </summary>
    private System.Threading.Timer? _permitLockoutTimer;

    /// <summary>
    /// true, если токен не удалось получить из HttpContext — тогда OnAfterRenderAsync
    /// дочитывает его из meta-тега (страховка на случай, когда HttpContext в circuit
    /// недоступен: поведение зависит от версии .NET и режима хостинга).
    /// </summary>
    private bool _tokenMissing;

    private bool isLocked;
    private int lockoutSeconds;
    private System.Threading.Timer? _lockoutTimer;

    /// <summary>
    /// ES-модуль AppWindow.razor.js (JS-isolation): управляет фоном страницы
    /// и служит страховкой CSRF-токена — дочитывает его из meta-тега,
    /// если токен не получен из HttpContext.
    /// </summary>
    private IJSObjectReference? _windowModule;

    /// <summary>
    /// Инициализация: если уже авторизован — на Home; иначе CSRF, ошибка из query, блокировка.
    /// Токен получается из HttpContext текущего HTTP-запроса: при prerender это
    /// документ-запрос, при интерактивном рендере — стартовый запрос circuit
    /// (в .NET 10 IHttpContextAccessor в circuit не пуст, пара cookie+токен валидна).
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        try
        {
            AuthenticationState authState = await AuthStateProvider.GetAuthenticationStateAsync();
            if (authState.User.Identity?.IsAuthenticated == true)
            {
                Navigation.NavigateTo("/", forceLoad: true);
                return;
            }

            HttpContext? http = HttpContextAccessor.HttpContext;
            if (http is not null)
            {
                AntiforgeryTokenSet tokens = Antiforgery.GetAndStoreTokens(http);
                antiforgeryToken = tokens.RequestToken ?? string.Empty;
            }
            _tokenMissing = string.IsNullOrEmpty(antiforgeryToken);

            Uri uri = Navigation.ToAbsoluteUri(Navigation.Uri);
            Dictionary<string, StringValues> query = QueryHelpers.ParseQuery(uri.Query);

            if (query.TryGetValue("error", out StringValues error))
            {
                if (error == "locked")
                {
                    int retry = 30;
                    if (query.TryGetValue("retry", out StringValues retryVal) &&
                        int.TryParse(retryVal, out int parsed) &&
                        parsed > 0)
                    {
                        retry = parsed;
                    }
                    StartLockout(retry);
                }
                else
                {
                    errorMessage = error == "invalid" ? "Неверный логин или пароль." :
                                   error == "server" ? "Ошибка сервера при входе." : "Ошибка входа.";
                }
            }

            // Исходный путь для возврата после входа: кладётся cookie-аутентификацией
            // при [Authorize]-редиректе с защищённой страницы (см. LoginAsync в AccountEndpoints).
            if (query.TryGetValue("ReturnUrl", out StringValues returnUrlValues) &&
                !string.IsNullOrEmpty(returnUrlValues))
            {
                returnUrl = returnUrlValues.ToString();
            }

            // На случай обновления страницы во время блокировки — сверяемся с LoginGuard
            if (!isLocked)
            {
                string clientIp = http?.Connection.RemoteIpAddress?.ToString() ?? "unknown";
                if (LoginGuard.IsLocked(clientIp, null, out int remain) && remain > 0)
                    StartLockout(remain);
            }
        }
        catch (Exception ex)
        {
            Log.Error(ex, "Исключение в {Class}.{Method}", ClassName, nameof(OnInitializedAsync));
            errorMessage = "Ошибка инициализации страницы.";
        }
    }

    /// <summary>
    /// После первого интерактивного рендера применяет фон страницы
    /// (body.ws-window-page) и при необходимости дочитывает CSRF-токен
    /// из meta-тега. Фон ставится страницей, а не окнами: окна страницы
    /// /entry сменяют друг друга, и DisposeAsync старого окна может
    /// выполниться уже после первого рендера нового — при управлении
    /// из окон фон мигнул бы или пропал.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (!firstRender)
            {
                return;
            }

            _windowModule ??= await Js.InvokeAsync<IJSObjectReference>("import", "./Components/Shared/AppWindow.razor.js");
            await _windowModule.InvokeVoidAsync("setPageBackground", true);

            if (!_tokenMissing)
            {
                return;
            }

            string? fromMeta = await _windowModule.InvokeAsync<string?>("getAntiforgeryToken");
            if (!string.IsNullOrEmpty(fromMeta))
            {
                antiforgeryToken = fromMeta;
                _tokenMissing = false;
                StateHasChanged();
            }
        }
        catch (JSDisconnectedException)
        {
            // Цепь Blazor разорвана — страница уходит.
        }
        catch (InvalidOperationException)
        {
            // Статический рендер — interop недоступен.
        }
        catch (Exception ex)
        {
            Log.Error(ex, "Исключение в {Class}.{Method}", ClassName, nameof(OnAfterRenderAsync));
        }
    }

    /// <summary>
    /// Открывает окно «Активация разрешения» вместо окна «Вход в систему»
    /// (кнопка «Зарегистрироваться» на форме входа) и синхронизирует отсчёт
    /// блокировки с сервером: после обновления страницы (новая цепь Blazor
    /// с пустым CountdownLockout) и при повторном открытии окна отсчёт
    /// продолжается с тем же остатком.
    /// </summary>
    private void OpenPermitActivation()
    {
        currentWindow = EntryWindow.PermitActivation;
        SyncPermitLockoutFromGuard();
    }

    /// <summary>
    /// Синхронизирует локальный отсчёт блокировки окна «Активация разрешения»
    /// с серверным PermitActivationGuard: сервер хранит момент окончания
    /// блокировки и её номер (эскалация длительности) и является источником
    /// истины. Заблокировано — отсчёт продолжается с серверного остатка;
    /// не заблокировано — локальный остаток сбрасывается (страховка от
    /// рассинхронизации после длительного простоя окна закрытым).
    /// </summary>
    private void SyncPermitLockoutFromGuard()
    {
        try
        {
            if (PermitGuard.IsLocked(ClientIp, out int remaining) && remaining > 0)
            {
                StartPermitLockout(remaining);
            }
            else
            {
                permitLockout.Start(0);
                _permitLockoutTimer?.Dispose();
                _permitLockoutTimer = null;
            }
        }
        catch (Exception ex)
        {
            Log.Error(ex, "Исключение в {Class}.{Method}", ClassName, nameof(SyncPermitLockoutFromGuard));
        }
    }

    /// <summary>
    /// Возвращает пользователя на окно «Вход в систему»: колбэк закрытия
    /// окна «Активация разрешения» (AppWindow.OnClose → JS NotifyClosedAsync).
    /// Введённый пермит сбрасывается. Активная блокировка сохраняется:
    /// отсчёт живёт на сервере (PermitActivationGuard), при повторном открытии
    /// окна он продолжается с того же остатка.
    /// </summary>
    private void ClosePermitActivation()
    {
        permitValue = string.Empty;
        permitErrorMessage = string.Empty;
        currentWindow = EntryWindow.Login;
    }

    /// <summary>
    /// Возвращает пользователя на окно «Вход в систему»: колбэк закрытия
    /// окна «Подача заявки на регистрацию» (AppWindow.OnClose →
    /// JS NotifyClosedAsync). Введённые данные заявки сбрасываются
    /// вместе с размонтированием формы; проверенный пермит также
    /// сбрасывается (повторное открытие окна заявки требует новой проверки
    /// пермита в окне активации).
    /// </summary>
    private void CloseRegistrationApplication()
    {
        activePermit = string.Empty;
        currentWindow = EntryWindow.Login;
    }

    /// <summary>
    /// Обрабатывает нажатие «Продолжить»: проверяет пермит в БД
    /// (RegistrationPermitChecker). Пермит найден и счётчик регистраций
    /// больше нуля — открывается окно подачи заявки (эскалация блокировок
    /// сбрасывается). Неверный или исчерпанный пермит не уводит пользователя
    /// с окна: поведение как при неверной паре логин/пароль на форме входа —
    /// блокировка с обратным отсчётом уже после первой неудачной попытки
    /// (PermitCheckOutcome), без красного сообщения: оранжевый блок с таймером
    /// под кнопкой. Длительность блокировки (15 с, удвоение за каждую следующую
    /// неудачу до предела 15 минут) хранит серверный PermitActivationGuard —
    /// обновление страницы не сбрасывает отсчёт. Пустое значение и ошибки
    /// сервера не списываются на пользователя: сообщение без блокировки.
    /// </summary>
    private async Task SubmitPermitAsync()
    {
        const string method = nameof(SubmitPermitAsync);

        if (isCheckingPermit || permitLockout.IsLocked)
        {
            return;
        }

        // Страховка от рассинхронизации с сервером (например, вторая вкладка
        // с того же IP уже заблокировала активацию): серверная блокировка
        // проверяется до обращения к БД, отсчёт продолжается с остатка сервера
        if (PermitGuard.IsLocked(ClientIp, out int serverRemaining) && serverRemaining > 0)
        {
            StartPermitLockout(serverRemaining);
            return;
        }

        // Пустой ввод не проверяется в БД и не включает блокировку —
        // как пустая пара логин/пароль на форме входа (required не
        // пропускает пустую отправку до проверки)
        if (string.IsNullOrWhiteSpace(permitValue))
        {
            ApplyPermitOutcome(PermitCheckOutcome.FromEmptyInput());
            return;
        }

        isCheckingPermit = true;
        permitErrorMessage = string.Empty;

        try
        {
            RegistrationPermitCheckResult result = await PermitChecker.CheckAsync(permitValue);

            if (result.IsUsable)
            {
                // Успешная активация сбрасывает блокировки и эскалацию —
                // как RecordSuccess у LoginGuard после успешного входа.
                // Проверенный пермит передаётся окну заявки (списывается
                // только при успешной подаче); поле проверки очищается
                PermitGuard.RecordSuccess(ClientIp);
                activePermit = permitValue.Trim();
                permitValue = string.Empty;
                currentWindow = EntryWindow.RegistrationApplication;
            }
            else
            {
                // Пермит не найден или исчерпан: окно остаётся открытым —
                // блокировка с обратным отсчётом (без красного сообщения:
                // таймер включается сразу и заменяет его)
                permitValue = string.Empty;
                ApplyPermitOutcome(PermitCheckOutcome.FromResult(result));
            }
        }
        catch (OperationCanceledException ex)
        {
            Log.Debug(ex, "Проверка пермита отменена. Class={Class}, Method={Method}", ClassName, method);
        }
        catch (Exception ex)
        {
            Log.Error(ex, "Исключение в {Class}.{Method}", ClassName, method);
            ApplyPermitOutcome(PermitCheckOutcome.FromServerError());
        }
        finally
        {
            isCheckingPermit = false;
        }
    }

    /// <summary>
    /// Применяет решение по проверке пермита к окну «Активация разрешения»:
    /// показывает сообщение (пустой ввод, ошибка сервера) и при необходимости
    /// фиксирует неудачу на сервере — PermitActivationGuard.RecordFailure
    /// устанавливает блокировку уже после первой попытки и удваивает длительность
    /// каждой следующей (до 15 минут), а возвращённый остаток запускает
    /// обратный отсчёт в интерфейсе.
    /// </summary>
    /// <param name="outcome">Решение по проверке пермита (PermitCheckOutcome).</param>
    private void ApplyPermitOutcome(PermitCheckOutcome outcome)
    {
        permitErrorMessage = outcome.ErrorMessage ?? string.Empty;

        if (outcome.StartLockout)
        {
            int seconds = PermitGuard.RecordFailure(ClientIp);
            StartPermitLockout(seconds > 0 ? seconds : PermitActivationGuard.BaseLockoutSeconds);
        }
    }

    /// <summary>
    /// Запускает (или перезапускает) обратный отсчёт блокировки окна
    /// «Активация разрешения» на заданное число секунд: после неудачной
    /// проверки пермита — с серверной длительностью (эскалация удвоением),
    /// при открытии окна — с серверного остатка.
    /// </summary>
    /// <param name="seconds">Число секунд блокировки (остаток с сервера).</param>
    private void StartPermitLockout(int seconds)
    {
        try
        {
            permitLockout.Start(Math.Max(1, seconds));

            _permitLockoutTimer?.Dispose();
            _permitLockoutTimer = new System.Threading.Timer(_ => _ = TickPermitLockoutAsync(), null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
        }
        catch (Exception ex)
        {
            Log.Error(ex, "Исключение в {Class}.{Method}", ClassName, nameof(StartPermitLockout));
        }
    }

    /// <summary>
    /// Один тик обратного отсчёта блокировки окна «Активация разрешения».
    /// Асинхронный вызов выделен из колбэка таймера: задача не отбрасывается
    /// молча — все исключения наблюдаются и логируются (как в TickLockoutAsync).
    /// </summary>
    private async Task TickPermitLockoutAsync()
    {
        try
        {
            await InvokeAsync(() =>
            {
                permitLockout.Tick();
                if (!permitLockout.IsLocked)
                {
                    _permitLockoutTimer?.Dispose();
                    _permitLockoutTimer = null;
                }
                StateHasChanged();
            });
        }
        catch (JSDisconnectedException)
        {
            // Цепь Blazor разорвана — страница уходит, отсчёт больше не нужен.
            _permitLockoutTimer?.Dispose();
            _permitLockoutTimer = null;
        }
        catch (Exception ex)
        {
            Log.Error(ex, "Исключение в {Class}.{Method}", ClassName, nameof(TickPermitLockoutAsync));
        }
    }

    /// <summary>
    /// Запускает обратный отсчёт блокировки на форме.
    /// </summary>
    /// <param name="seconds">Число секунд до снятия блокировки.</param>
    private void StartLockout(int seconds)
    {
        try
        {
            isLocked = true;
            lockoutSeconds = Math.Max(1, seconds);
            errorMessage = string.Empty;

            _lockoutTimer?.Dispose();
            _lockoutTimer = new System.Threading.Timer(_ => _ = TickLockoutAsync(), null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
        }
        catch (Exception ex)
        {
            Log.Error(ex, "Исключение в {Class}.{Method}", ClassName, nameof(StartLockout));
        }
    }

    /// <summary>
    /// Один тик обратного отсчёта. Асинхронный вызов выделен из колбэка таймера:
    /// задача не отбрасывается молча — все исключения наблюдаются и логируются
    /// (необработанное исключение в отброшенной задаче таймера способно уронить процесс).
    /// </summary>
    private async Task TickLockoutAsync()
    {
        try
        {
            await InvokeAsync(() =>
            {
                lockoutSeconds--;
                if (lockoutSeconds <= 0)
                {
                    isLocked = false;
                    lockoutSeconds = 0;
                    _lockoutTimer?.Dispose();
                    _lockoutTimer = null;
                }
                StateHasChanged();
            });
        }
        catch (JSDisconnectedException)
        {
            // Цепь Blazor разорвана — страница уходит, отсчёт больше не нужен.
            _lockoutTimer?.Dispose();
            _lockoutTimer = null;
        }
        catch (Exception ex)
        {
            Log.Error(ex, "Исключение в {Class}.{Method}", ClassName, nameof(TickLockoutAsync));
        }
    }

    /// <summary>
    /// Освобождает таймеры блокировки и ссылку на импортированный JS-модуль.
    /// </summary>
    public async ValueTask DisposeAsync()
    {
        _lockoutTimer?.Dispose();
        _lockoutTimer = null;

        _permitLockoutTimer?.Dispose();
        _permitLockoutTimer = null;

        if (_windowModule is not null)
        {
            try
            {
                // Снимаем фон страницы, поставленный в OnAfterRenderAsync
                await _windowModule.InvokeVoidAsync("setPageBackground", false);
            }
            catch (JSDisconnectedException)
            {
            }
            catch (InvalidOperationException)
            {
            }

            try
            {
                await _windowModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
            catch (InvalidOperationException)
            {
            }

            _windowModule = null;
        }
    }
}
