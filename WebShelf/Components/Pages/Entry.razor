@page "/entry"
@rendermode InteractiveServer
@implements IAsyncDisposable

@using Microsoft.AspNetCore.Antiforgery
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.Extensions.Primitives
@using WebShelf.Classes.Service
@using WebShelf.Components.Shared
@using Serilog

@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject IAntiforgery Antiforgery
@inject IHttpContextAccessor HttpContextAccessor
@inject IJSRuntime Js
@inject LoginGuard LoginGuard
@inject RegistrationPermitChecker PermitChecker

<PageTitle>Вход в систему WebShelf</PageTitle>

@* Заголовок первого уровня для FocusOnNavigate и скринридеров *@
<h1 class="ws-visually-hidden">Вход в систему</h1>

@* Окна страницы /entry показываются по очереди: «Вход в систему»,
   «Активация разрешения» и «Подача заявки на регистрацию» — переключаются
   кнопкой «Зарегистрироваться», кнопкой «Продолжить» (проверка пермита в БД)
   и закрытием окон. Фон страницы (body.ws-window-page) ведёт
   сама страница (см. OnAfterRenderAsync/DisposeAsync): при смене окон
   DisposeAsync старого окна может выполниться после первого рендера
   нового, поэтому окна рендерятся с ApplyPageBackground=false. *@
@if (currentWindow == EntryWindow.Login)
{
    <AppWindow Title="Вход в систему — WebShelf"
               IconText="WS"
               CanClose="false"
               CloseBubbleText="Это окно не может быть закрыто"
               ApplyPageBackground="false"
               MaxWidth="420px">

    <form method="post" action="/account/login" autocomplete="on">
        @* CSRF-токен: поле обязательно. Blazor не подставляет токен автоматически
           в <form> внутри интерактивных компонентов — без этого поля вход невозможен.
           Значение — пара к cookie WebShelf.Antiforgery текущего запроса. *@
        <input type="hidden" name="__RequestVerificationToken" value="@antiforgeryToken" />

        @* Исходный путь пользователя: заполняется из query ReturnUrl, который кладёт
           cookie-аутентификация при [Authorize]-редиректе с защищённой страницы. *@
        <input type="hidden" name="returnUrl" value="@returnUrl" />

        <div class="ws-form-group">
            <label for="username">Имя пользователя (AD)</label>
            <div class="ws-input-wrapper">
                <input type="text"
                       id="username"
                       name="username"
                       placeholder="Логин"
                       required
                       autofocus
                       autocomplete="username"
                       disabled="@isLocked" />
            </div>
        </div>

        <div class="ws-form-group">
            <label for="password">Пароль</label>
            <div class="ws-input-wrapper">
                <input type="password"
                       id="password"
                       name="password"
                       placeholder="Пароль"
                       required
                       autocomplete="current-password"
                       disabled="@isLocked" />
                <button type="button"
                        class="ws-toggle-password ws-hidden-eye"
                        aria-label="Показать пароль"
                        title="Показать / скрыть пароль"
                        disabled="@isLocked">
                    👁
                </button>
            </div>
        </div>

        <div class="ws-form-check">
            <input type="checkbox"
                   name="rememberMe"
                   value="true"
                   id="rememberMe"
                   disabled="@isLocked" />
            <label for="rememberMe">Запомнить меня</label>
        </div>

        <button type="submit" class="ws-btn-primary" disabled="@isLocked">
            @(isLocked ? "Вход временно заблокирован" : "Войти")
        </button>

        @* type="button": форма POST-ит на /account/login, клик не должен её отправлять.
           Кнопка блокируется на 15 с после неудачной проверки пермита
           (CountdownLockout, обратный отсчёт в тексте кнопки) *@
        <button type="button" class="ws-btn-secondary" @onclick="OpenPermitActivation" disabled="@registrationLockout.IsLocked">
            @(registrationLockout.IsLocked
                ? $"Регистрация доступна через {registrationLockout.RemainingSeconds} с."
                : "Зарегистрироваться")
        </button>

        @if (isLocked)
        {
            <div class="ws-message ws-message-lockout" role="alert">
                Слишком много неудачных попыток входа.
                Повторите через <strong>@lockoutSeconds</strong> с.
            </div>
        }
        else if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="ws-message ws-message-error" role="alert">@errorMessage</div>
        }
    </form>
</AppWindow>
}
else if (currentWindow == EntryWindow.PermitActivation)
{
    @* Окно «Активация разрешения»: визуально повторяет окно входа (тот же AppWindow
       и стили window.css). Закрытие кнопкой «×» возвращает на окно входа через OnClose.
       Кнопка «Продолжить» проверяет пермит в БД (RegistrationPermitChecker):
       пермит найден и счётчик регистраций больше нуля — открывается окно подачи
       заявки, иначе пользователь возвращается на окно входа с блокировкой кнопки
       «Зарегистрироваться» на 15 с. *@
    <AppWindow Title="Активация разрешения — WebShelf"
               IconText="WS"
               CanClose="true"
               OnClose="ClosePermitActivation"
               ApplyPageBackground="false"
               MaxWidth="420px">
        <div class="ws-form-group">
            <label for="permit">Пермит</label>
            <div class="ws-input-wrapper">
                <input type="text"
                       id="permit"
                       placeholder="Введите ключ разрешения"
                       required
                       autocomplete="off"
                       disabled="@isCheckingPermit"
                       @bind="permitValue"
                       @bind:event="oninput" />
            </div>
        </div>

        @* Ошибка сервера при проверке пермита: окно остаётся открытым,
           повторная попытка возможна сразу *@
        @if (!string.IsNullOrEmpty(permitErrorMessage))
        {
            <div class="ws-message ws-message-error" role="alert">@permitErrorMessage</div>
        }

        <button type="button" class="ws-btn-primary" @onclick="SubmitPermitAsync" disabled="@isCheckingPermit">
            @(isCheckingPermit ? "Проверка пермита..." : "Продолжить")
        </button>
    </AppWindow>
}
else
{
    @* Окно «Подача заявки на регистрацию»: открывается после успешной проверки
       пермита (найден в БД, счётчик регистраций больше нуля). Закрытие кнопкой
       «×» возвращает на окно входа (не в окно активации). Форма — компонент
       RegistrationApplicationForm; состояние формы сбрасывается закрытием
       окна (компонент размонтируется). *@
    <AppWindow Title="Подача заявки на регистрацию — WebShelf"
               IconText="WS"
               CanClose="true"
               OnClose="CloseRegistrationApplication"
               ApplyPageBackground="false"
               MaxWidth="420px">
        <RegistrationApplicationForm />
    </AppWindow>
}

@code {
    private const string ClassName = "WebShelf.Components.Pages.Entry";

    private string errorMessage = string.Empty;
    private string antiforgeryToken = string.Empty;
    private string returnUrl = string.Empty;

    /// <summary>
    /// Окно страницы /entry, показываемое в текущий момент.
    /// Окна сменяют друг друга: на странице всегда ровно одно окно.
    /// </summary>
    private enum EntryWindow
    {
        /// <summary>Окно «Вход в систему» (форма входа).</summary>
        Login,

        /// <summary>Окно «Активация разрешения» (ввод пермита).</summary>
        PermitActivation,

        /// <summary>Окно «Подача заявки на регистрацию» (анкета кандидата).</summary>
        RegistrationApplication
    }

    /// <summary>
    /// Текущее окно страницы /entry; по умолчанию — окно «Вход в систему».
    /// </summary>
    private EntryWindow currentWindow = EntryWindow.Login;

    /// <summary>
    /// Значение поля «Пермит». Не сохраняется при смене окон: возврат
    /// на окно входа и обратно сбрасывает ввод.
    /// </summary>
    private string permitValue = string.Empty;

    /// <summary>
    /// Сообщение об ошибке сервера при проверке пермита (показывается
    /// в окне активации; пустое — ошибки нет).
    /// </summary>
    private string permitErrorMessage = string.Empty;

    /// <summary>
    /// true — выполняется проверка пермита в БД: поле и кнопка «Продолжить»
    /// заблокированы, повторный запуск проверки исключён.
    /// </summary>
    private bool isCheckingPermit;

    /// <summary>
    /// Длительность блокировки кнопки «Зарегистрироваться» после
    /// неудачной проверки пермита, секунд.
    /// </summary>
    private const int RegistrationLockoutSeconds = 15;

    /// <summary>
    /// Блокировка кнопки «Зарегистрироваться» после неудачной проверки
    /// пермита: 15 секунд с обратным отсчётом (CountdownLockout).
    /// </summary>
    private readonly CountdownLockout registrationLockout = new();

    /// <summary>
    /// Таймер обратного отсчёта блокировки кнопки «Зарегистрироваться».
    /// </summary>
    private System.Threading.Timer? _registrationLockoutTimer;

    /// <summary>
    /// true, если токен не удалось получить из HttpContext — тогда OnAfterRenderAsync
    /// дочитывает его из meta-тега (страховка на случай, когда HttpContext в circuit
    /// недоступен: поведение зависит от версии .NET и режима хостинга).
    /// </summary>
    private bool _tokenMissing;

    private bool isLocked;
    private int lockoutSeconds;
    private System.Threading.Timer? _lockoutTimer;

    /// <summary>
    /// ES-модуль AppWindow.razor.js (JS-isolation): управляет фоном страницы
    /// и служит страховкой CSRF-токена — дочитывает его из meta-тега,
    /// если токен не получен из HttpContext.
    /// </summary>
    private IJSObjectReference? _windowModule;

    /// <summary>
    /// Инициализация: если уже авторизован — на Home; иначе CSRF, ошибка из query, блокировка.
    /// Токен получается из HttpContext текущего HTTP-запроса: при prerender это
    /// документ-запрос, при интерактивном рендере — стартовый запрос circuit
    /// (в .NET 10 IHttpContextAccessor в circuit не пуст, пара cookie+токен валидна).
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        try
        {
            AuthenticationState authState = await AuthStateProvider.GetAuthenticationStateAsync();
            if (authState.User.Identity?.IsAuthenticated == true)
            {
                Navigation.NavigateTo("/", forceLoad: true);
                return;
            }

            HttpContext? http = HttpContextAccessor.HttpContext;
            if (http is not null)
            {
                AntiforgeryTokenSet tokens = Antiforgery.GetAndStoreTokens(http);
                antiforgeryToken = tokens.RequestToken ?? string.Empty;
            }
            _tokenMissing = string.IsNullOrEmpty(antiforgeryToken);

            Uri uri = Navigation.ToAbsoluteUri(Navigation.Uri);
            Dictionary<string, StringValues> query = QueryHelpers.ParseQuery(uri.Query);

            if (query.TryGetValue("error", out StringValues error))
            {
                if (error == "locked")
                {
                    int retry = 30;
                    if (query.TryGetValue("retry", out StringValues retryVal) &&
                        int.TryParse(retryVal, out int parsed) &&
                        parsed > 0)
                    {
                        retry = parsed;
                    }
                    StartLockout(retry);
                }
                else
                {
                    errorMessage = error == "invalid" ? "Неверный логин или пароль." :
                                   error == "server" ? "Ошибка сервера при входе." : "Ошибка входа.";
                }
            }

            // Исходный путь для возврата после входа: кладётся cookie-аутентификацией
            // при [Authorize]-редиректе с защищённой страницы (см. LoginAsync в AccountEndpoints).
            if (query.TryGetValue("ReturnUrl", out StringValues returnUrlValues) &&
                !string.IsNullOrEmpty(returnUrlValues))
            {
                returnUrl = returnUrlValues.ToString();
            }

            // На случай обновления страницы во время блокировки — сверяемся с LoginGuard
            if (!isLocked)
            {
                string clientIp = http?.Connection.RemoteIpAddress?.ToString() ?? "unknown";
                if (LoginGuard.IsLocked(clientIp, null, out int remain) && remain > 0)
                    StartLockout(remain);
            }
        }
        catch (Exception ex)
        {
            Log.Error(ex, "Исключение в {Class}.{Method}", ClassName, nameof(OnInitializedAsync));
            errorMessage = "Ошибка инициализации страницы.";
        }
    }

    /// <summary>
    /// После первого интерактивного рендера применяет фон страницы
    /// (body.ws-window-page) и при необходимости дочитывает CSRF-токен
    /// из meta-тега. Фон ставится страницей, а не окнами: окна страницы
    /// /entry сменяют друг друга, и DisposeAsync старого окна может
    /// выполниться уже после первого рендера нового — при управлении
    /// из окон фон мигнул бы или пропал.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (!firstRender)
            {
                return;
            }

            _windowModule ??= await Js.InvokeAsync<IJSObjectReference>("import", "./Components/Shared/AppWindow.razor.js");
            await _windowModule.InvokeVoidAsync("setPageBackground", true);

            if (!_tokenMissing)
            {
                return;
            }

            string? fromMeta = await _windowModule.InvokeAsync<string?>("getAntiforgeryToken");
            if (!string.IsNullOrEmpty(fromMeta))
            {
                antiforgeryToken = fromMeta;
                _tokenMissing = false;
                StateHasChanged();
            }
        }
        catch (JSDisconnectedException)
        {
            // Цепь Blazor разорвана — страница уходит.
        }
        catch (InvalidOperationException)
        {
            // Статический рендер — interop недоступен.
        }
        catch (Exception ex)
        {
            Log.Error(ex, "Исключение в {Class}.{Method}", ClassName, nameof(OnAfterRenderAsync));
        }
    }

    /// <summary>
    /// Открывает окно «Активация разрешения» вместо окна «Вход в систему»
    /// (кнопка «Зарегистрироваться» на форме входа). При активной блокировке
    /// не вызывается: кнопка заблокирована.
    /// </summary>
    private void OpenPermitActivation()
    {
        currentWindow = EntryWindow.PermitActivation;
    }

    /// <summary>
    /// Возвращает пользователя на окно «Вход в систему»: колбэк закрытия
    /// окна «Активация разрешения» (AppWindow.OnClose → JS NotifyClosedAsync).
    /// Введённый пермит сбрасывается.
    /// </summary>
    private void ClosePermitActivation()
    {
        permitValue = string.Empty;
        permitErrorMessage = string.Empty;
        currentWindow = EntryWindow.Login;
    }

    /// <summary>
    /// Возвращает пользователя на окно «Вход в систему»: колбэк закрытия
    /// окна «Подача заявки на регистрацию» (AppWindow.OnClose →
    /// JS NotifyClosedAsync). Введённые данные заявки сбрасываются
    /// вместе с размонтированием формы.
    /// </summary>
    private void CloseRegistrationApplication()
    {
        currentWindow = EntryWindow.Login;
    }

    /// <summary>
    /// Обрабатывает нажатие «Продолжить»: проверяет пермит в БД
    /// (RegistrationPermitChecker). Пермит найден и счётчик регистраций
    /// больше нуля — открывается окно подачи заявки; иначе пользователь
    /// возвращается на окно входа, а кнопка «Зарегистрироваться»
    /// блокируется на 15 с с обратным отсчётом. Ошибки сервера не
    /// списываются на пользователя: окно остаётся открытым с сообщением.
    /// </summary>
    private async Task SubmitPermitAsync()
    {
        const string method = nameof(SubmitPermitAsync);

        if (isCheckingPermit)
        {
            return;
        }

        isCheckingPermit = true;
        permitErrorMessage = string.Empty;

        try
        {
            RegistrationPermitCheckResult result = await PermitChecker.CheckAsync(permitValue);

            // Введённый пермит не сохраняется при смене окна
            permitValue = string.Empty;

            if (result.IsUsable)
            {
                currentWindow = EntryWindow.RegistrationApplication;
            }
            else
            {
                // Пермит не найден или исчерпан: возврат на окно входа
                // с блокировкой кнопки «Зарегистрироваться»
                currentWindow = EntryWindow.Login;
                StartRegistrationLockout();
            }
        }
        catch (OperationCanceledException ex)
        {
            Log.Debug(ex, "Проверка пермита отменена. Class={Class}, Method={Method}", ClassName, method);
        }
        catch (Exception ex)
        {
            Log.Error(ex, "Исключение в {Class}.{Method}", ClassName, method);
            permitErrorMessage = "Ошибка сервера при проверке пермита. Повторите попытку.";
        }
        finally
        {
            isCheckingPermit = false;
        }
    }

    /// <summary>
    /// Запускает обратный отсчёт блокировки кнопки «Зарегистрироваться»
    /// после неудачной проверки пермита (15 с).
    /// </summary>
    private void StartRegistrationLockout()
    {
        try
        {
            registrationLockout.Start(RegistrationLockoutSeconds);

            _registrationLockoutTimer?.Dispose();
            _registrationLockoutTimer = new System.Threading.Timer(_ => _ = TickRegistrationLockoutAsync(), null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
        }
        catch (Exception ex)
        {
            Log.Error(ex, "Исключение в {Class}.{Method}", ClassName, nameof(StartRegistrationLockout));
        }
    }

    /// <summary>
    /// Один тик обратного отсчёта блокировки кнопки «Зарегистрироваться».
    /// Асинхронный вызов выделен из колбэка таймера: задача не отбрасывается
    /// молча — все исключения наблюдаются и логируются (как в TickLockoutAsync).
    /// </summary>
    private async Task TickRegistrationLockoutAsync()
    {
        try
        {
            await InvokeAsync(() =>
            {
                registrationLockout.Tick();
                if (!registrationLockout.IsLocked)
                {
                    _registrationLockoutTimer?.Dispose();
                    _registrationLockoutTimer = null;
                }
                StateHasChanged();
            });
        }
        catch (JSDisconnectedException)
        {
            // Цепь Blazor разорвана — страница уходит, отсчёт больше не нужен.
            _registrationLockoutTimer?.Dispose();
            _registrationLockoutTimer = null;
        }
        catch (Exception ex)
        {
            Log.Error(ex, "Исключение в {Class}.{Method}", ClassName, nameof(TickRegistrationLockoutAsync));
        }
    }

    /// <summary>
    /// Запускает обратный отсчёт блокировки на форме.
    /// </summary>
    /// <param name="seconds">Число секунд до снятия блокировки.</param>
    private void StartLockout(int seconds)
    {
        try
        {
            isLocked = true;
            lockoutSeconds = Math.Max(1, seconds);
            errorMessage = string.Empty;

            _lockoutTimer?.Dispose();
            _lockoutTimer = new System.Threading.Timer(_ => _ = TickLockoutAsync(), null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
        }
        catch (Exception ex)
        {
            Log.Error(ex, "Исключение в {Class}.{Method}", ClassName, nameof(StartLockout));
        }
    }

    /// <summary>
    /// Один тик обратного отсчёта. Асинхронный вызов выделен из колбэка таймера:
    /// задача не отбрасывается молча — все исключения наблюдаются и логируются
    /// (необработанное исключение в отброшенной задаче таймера способно уронить процесс).
    /// </summary>
    private async Task TickLockoutAsync()
    {
        try
        {
            await InvokeAsync(() =>
            {
                lockoutSeconds--;
                if (lockoutSeconds <= 0)
                {
                    isLocked = false;
                    lockoutSeconds = 0;
                    _lockoutTimer?.Dispose();
                    _lockoutTimer = null;
                }
                StateHasChanged();
            });
        }
        catch (JSDisconnectedException)
        {
            // Цепь Blazor разорвана — страница уходит, отсчёт больше не нужен.
            _lockoutTimer?.Dispose();
            _lockoutTimer = null;
        }
        catch (Exception ex)
        {
            Log.Error(ex, "Исключение в {Class}.{Method}", ClassName, nameof(TickLockoutAsync));
        }
    }

    /// <summary>
    /// Освобождает таймер блокировки и ссылку на импортированный JS-модуль.
    /// </summary>
    public async ValueTask DisposeAsync()
    {
        _lockoutTimer?.Dispose();
        _lockoutTimer = null;

        _registrationLockoutTimer?.Dispose();
        _registrationLockoutTimer = null;

        if (_windowModule is not null)
        {
            try
            {
                // Снимаем фон страницы, поставленный в OnAfterRenderAsync
                await _windowModule.InvokeVoidAsync("setPageBackground", false);
            }
            catch (JSDisconnectedException)
            {
            }
            catch (InvalidOperationException)
            {
            }

            try
            {
                await _windowModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
            catch (InvalidOperationException)
            {
            }

            _windowModule = null;
        }
    }
}
