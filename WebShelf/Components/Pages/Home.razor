@page "/"
@rendermode InteractiveServer

@using System.DirectoryServices.AccountManagement
@using Microsoft.AspNetCore.Components.Authorization
@using WebShelf.Classes.Service
@using WebShelf.Components.Shared

@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Вход в систему WebShelf</PageTitle>

@if (isAuthenticated)
{
    <div class="alert alert-success d-flex justify-content-between align-items-center">
        <span>Вы вошли как <strong>@currentUser</strong></span>
        <button class="btn btn-outline-danger btn-sm" @onclick="Logout">Выйти</button>
    </div>

    <h1>Пользователи системы WebShelf</h1>

    @if (users.Count == 0)
    {
        <div class="alert alert-warning">Пользователи не найдены.</div>
    }
    else
    {
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Логин</th>
                    <th>Отображаемое имя</th>
                    <th>Электронная почта</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in users)
                {
                    <tr>
                        <td>@user.SamAccountName</td>
                        <td>@user.DisplayName</td>
                        <td>@user.Email</td>
                    </tr>
                }
            </tbody>
        </table>
    }
}
else
{
    @* Окно входа: оболочка AppWindow + форма POST на /account/login *@
    <AppWindow Title="Вход в систему — WebShelf"
               IconText="WS"
               CanClose="false"
               CloseBubbleText="Это окно не может быть закрыто"
               ApplyPageBackground="true"
               MaxWidth="420px">

        <form method="post" action="/account/login" autocomplete="on">
            <div class="ws-form-group">
                <label for="username">Имя пользователя (AD)</label>
                <div class="ws-input-wrapper">
                    <input type="text"
                           id="username"
                           name="username"
                           placeholder="DOMAIN\user или user@domain"
                           required
                           autofocus
                           autocomplete="username" />
                </div>
            </div>

            <div class="ws-form-group">
                <label for="password">Пароль</label>
                <div class="ws-input-wrapper">
                    <input type="password"
                           id="password"
                           name="password"
                           placeholder="Введите пароль"
                           required
                           autocomplete="current-password" />
                    <button type="button"
                            class="ws-toggle-password ws-hidden-eye"
                            aria-label="Показать пароль"
                            title="Показать / скрыть пароль">
                        👁
                    </button>
                </div>
            </div>

            <div class="ws-form-check">
                <input type="checkbox" name="rememberMe" value="true" id="rememberMe" />
                <label for="rememberMe">Запомнить меня</label>
            </div>

            <button type="submit" class="ws-btn-primary">Войти</button>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="ws-message ws-message-error" role="alert">@errorMessage</div>
            }
        </form>
    </AppWindow>
}

@code {
    /// <summary>
    /// Краткая информация о пользователе AD для таблицы.
    /// </summary>
    private sealed record UserInfo(string SamAccountName, string DisplayName, string Email);

    private List<UserInfo> users = [];
    private string errorMessage = string.Empty;
    private bool isAuthenticated;
    private string currentUser = string.Empty;

    /// <summary>
    /// Инициализация: чтение ошибки из query-string и проверка аутентификации.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
            if (Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query).TryGetValue("error", out var error))
            {
                errorMessage = error == "invalid" ? "Неверный логин или пароль." :
                               error == "server" ? "Ошибка сервера при входе." : "Ошибка входа.";
            }

            await CheckAuth();
            if (isAuthenticated)
                LoadUsers();
        }
        catch (Exception ex)
        {
            // В Blazor-компоненте используем Console; серверный Serilog — в endpoint'ах Program.cs
            Console.Error.WriteLine($"Исключение в WebShelf.Components.Pages.Home.OnInitializedAsync: {ex}");
            errorMessage = "Ошибка инициализации страницы.";
        }
    }

    /// <summary>
    /// Проверяет состояние аутентификации текущего пользователя.
    /// </summary>
    private async Task CheckAuth()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            isAuthenticated = authState.User.Identity?.IsAuthenticated == true;
            currentUser = authState.User.Identity?.Name ?? "";
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Исключение в WebShelf.Components.Pages.Home.CheckAuth: {ex}");
            isAuthenticated = false;
            currentUser = string.Empty;
        }
    }

    /// <summary>
    /// Загружает список пользователей домена через Data.Domain.
    /// </summary>
    private void LoadUsers()
    {
        try
        {
            if (Data.Domain is null) return;

            var adUsers = Data.Domain.GetAllUsers();

            users = adUsers
                .Select(u => new UserInfo(
                    u.SamAccountName,
                    u.DisplayName,
                    u.Email))
                .OrderBy(u => u.DisplayName)
                .ToList();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Исключение в WebShelf.Components.Pages.Home.LoadUsers: {ex}");
            users = [];
        }
    }

    /// <summary>
    /// Выход из системы — переход на /account/logout с полной перезагрузкой.
    /// </summary>
    private void Logout()
    {
        try
        {
            Navigation.NavigateTo("/account/logout", forceLoad: true);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Исключение в WebShelf.Components.Pages.Home.Logout: {ex}");
        }
    }
}