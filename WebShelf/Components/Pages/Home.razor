@page "/"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Components.Authorization
@using WebShelf.Components.Shared

@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject ILogger<Home> Logger
@inject IJSRuntime Js

<PageTitle>WebShelf</PageTitle>

@if (isAuthenticated)
{
    <RibbonMenu CurrentUser="@currentUser" />
}

@code {
    private const string ClassName = "WebShelf.Components.Pages.Home";

    private bool isAuthenticated;
    private string currentUser = string.Empty;
    private bool _pageBgApplied;

    /// <summary>
    /// Если пользователь не авторизован — редирект на Entry.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        try
        {
            await CheckAuth();

            if (!isAuthenticated)
            {
                Navigation.NavigateTo("/entry", forceLoad: true);
                return;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Исключение в {Class}.{Method}", ClassName, nameof(OnInitializedAsync));
        }
    }

    /// <summary>
    /// Применяет фон страницы для ленты после рендера.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (!firstRender || _pageBgApplied || !isAuthenticated)
            {
                return;
            }

            await Js.InvokeVoidAsync("WebShelfRibbon.setPageBackground", true);
            _pageBgApplied = true;
        }
        catch (JSDisconnectedException)
        {
        }
        catch (InvalidOperationException)
        {
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Исключение в {Class}.{Method}", ClassName, nameof(OnAfterRenderAsync));
        }
    }

    /// <summary>
    /// Проверяет состояние аутентификации текущего пользователя.
    /// </summary>
    private async Task CheckAuth()
    {
        try
        {
            AuthenticationState authState = await AuthStateProvider.GetAuthenticationStateAsync();
            isAuthenticated = authState.User.Identity?.IsAuthenticated == true;
            currentUser = authState.User.Identity?.Name ?? string.Empty;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Исключение в {Class}.{Method}", ClassName, nameof(CheckAuth));
            isAuthenticated = false;
            currentUser = string.Empty;
        }
    }
}