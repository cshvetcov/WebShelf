@page "/"
@rendermode InteractiveServer
@attribute [Authorize]
@implements IAsyncDisposable

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using WebShelf.Classes.Security
@using WebShelf.Components.Shared
@using Serilog

@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime Js

<PageTitle>WebShelf</PageTitle>

@* Заголовок первого уровня для FocusOnNavigate и скринридеров *@
<h1 class="ws-visually-hidden">WebShelf</h1>

@if (isAuthenticated)
{
    <RibbonMenu CurrentUser="@currentUser" CurrentRole="@currentRole" />
}

@code {
    private const string ClassName = "WebShelf.Components.Pages.Home";

    private bool isAuthenticated;
    private string currentUser = string.Empty;
    private string currentRole = string.Empty;
    private bool _pageBgApplied;

    /// <summary>
    /// ES-модуль RibbonMenu.razor.js (JS-isolation): импортируется один раз
    /// за цепочку для применения фона страницы ленты.
    /// </summary>
    private IJSObjectReference? _ribbonModule;

    /// <summary>
    /// Если пользователь не авторизован — редирект на Entry.
    /// Страница также защищена атрибутом [Authorize]: неаутентифицированный
    /// запрос документа отклоняется на уровне endpoint (302 на /entry?ReturnUrl=...)
    /// ещё до построения circuit. Проверка ниже — вторая линия обороны:
    /// она срабатывает, если страница отрендерилась в circuit без аутентификации.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        try
        {
            await CheckAuth();

            if (!isAuthenticated)
            {
                Navigation.NavigateTo("/entry", forceLoad: true);
                return;
            }
        }
        catch (Exception ex)
        {
            Log.Error(ex, "Исключение в {Class}.{Method}", ClassName, nameof(OnInitializedAsync));
        }
    }

    /// <summary>
    /// Применяет фон страницы для ленты после рендера: импортирует модуль ленты
    /// (JS-isolation) и вызывает setPageBackground.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (!firstRender || _pageBgApplied || !isAuthenticated)
            {
                return;
            }

            _ribbonModule = await Js.InvokeAsync<IJSObjectReference>("import", "./Components/Shared/RibbonMenu.razor.js");
            await _ribbonModule.InvokeVoidAsync("setPageBackground", true);
            _pageBgApplied = true;
        }
        catch (JSDisconnectedException)
        {
        }
        catch (InvalidOperationException)
        {
        }
        catch (Exception ex)
        {
            Log.Error(ex, "Исключение в {Class}.{Method}", ClassName, nameof(OnAfterRenderAsync));
        }
    }

    /// <summary>
    /// Освобождает ссылку на импортированный JS-модуль ленты.
    /// </summary>
    public async ValueTask DisposeAsync()
    {
        if (_ribbonModule is not null)
        {
            try
            {
                await _ribbonModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
            catch (InvalidOperationException)
            {
            }

            _ribbonModule = null;
        }
    }

    /// <summary>
    /// Проверяет состояние аутентификации текущего пользователя.
    /// Роль берётся из клейма Role состояния: провайдер обновляет его
    /// в цепочке при смене роли в AD, лента перерисовывается без перезагрузки.
    /// </summary>
    private async Task CheckAuth()
    {
        try
        {
            AuthenticationState authState = await AuthStateProvider.GetAuthenticationStateAsync();
            isAuthenticated = authState.User.Identity?.IsAuthenticated == true;
            currentUser = authState.User.Identity?.Name ?? string.Empty;

            // Отображаемое имя эффективной роли — по клейму Role из состояния
            string? roleSystemName = authState.User.FindFirst(ClaimTypes.Role)?.Value;
            AppRole? role = RoleCatalog.TryGetBySystemName(roleSystemName);
            currentRole = role?.DisplayName ?? string.Empty;
        }
        catch (Exception ex)
        {
            Log.Error(ex, "Исключение в {Class}.{Method}", ClassName, nameof(CheckAuth));
            isAuthenticated = false;
            currentUser = string.Empty;
            currentRole = string.Empty;
        }
    }
}
