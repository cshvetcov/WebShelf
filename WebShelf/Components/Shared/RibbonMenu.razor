@*
  RibbonMenu — основное ленточное меню приложения WebShelf.
  Визуальный каркас по образцу классической ленты; функционал кнопок не подключён.
  Стили: wwwroot/css/ribbon.css
  Скрипт: Components/Shared/RibbonMenu.razor.js (JS-isolation, ES-модуль)
*@
@implements IAsyncDisposable
@using Serilog
@inject IJSRuntime Js

<div id="@RibbonElementId" class="ws-ribbon" role="region" aria-label="Главное меню">
    @* Верхняя полоса приложения *@
    <div class="ws-ribbon-appbar">
        <div class="ws-ribbon-appbar-title">
            <span class="ws-ribbon-appbar-icon" aria-hidden="true">WS</span>
            <span>WebShelf</span>
        </div>
        <div class="ws-ribbon-appbar-user">
            @if (!string.IsNullOrEmpty(CurrentUser))
            {
                <span>@CurrentUser</span>
            }
            @if (!string.IsNullOrEmpty(CurrentRole))
            {
                <span class="ws-ribbon-appbar-role" title="Текущая роль">[@CurrentRole]</span>
            }
            <button type="button" class="ws-ribbon-logout" @onclick="LogoutAsync">Выйти</button>
        </div>
    </div>

    @* Вкладки *@
    <div class="ws-ribbon-tabs" role="tablist">
        <button type="button" class="ws-ribbon-tab is-active" role="tab" data-tab="projects"
                aria-selected="true" id="tab-projects">
            Проекты
        </button>
        <button type="button" class="ws-ribbon-tab" role="tab" data-tab="users"
                aria-selected="false" id="tab-users">
            Пользователи
        </button>
    </div>

    @* Содержимое вкладок (только визуальные группы, без обработчиков) *@
    <div class="ws-ribbon-content">
        @* Панель «Проекты» *@
        <div class="ws-ribbon-panel is-active" data-panel="projects" role="tabpanel" aria-labelledby="tab-projects">
            <div class="ws-ribbon-group">
                <div class="ws-ribbon-group-items">
                    <div class="ws-ribbon-btn" title="Новый проект">
                        <span class="ws-ribbon-btn-icon" aria-hidden="true">📁</span>
                        <span class="ws-ribbon-btn-text">Новый проект</span>
                    </div>
                    <div class="ws-ribbon-btn" title="Текущие проекты">
                        <span class="ws-ribbon-btn-icon" aria-hidden="true">📋</span>
                        <span class="ws-ribbon-btn-text">Текущие проекты</span>
                    </div>
                    <div class="ws-ribbon-btn" title="Обновить">
                        <span class="ws-ribbon-btn-icon" aria-hidden="true">🔄</span>
                        <span class="ws-ribbon-btn-text">Обновить</span>
                    </div>
                </div>
                <div class="ws-ribbon-group-label">Управление</div>
            </div>
        </div>

        @* Панель «Пользователи» — каркас *@
        <div class="ws-ribbon-panel" data-panel="users" role="tabpanel" aria-labelledby="tab-users">
            <div class="ws-ribbon-group">
                <div class="ws-ribbon-group-items">
                    <div class="ws-ribbon-btn"><span class="ws-ribbon-btn-icon">👥</span><span class="ws-ribbon-btn-text">Пользователи</span></div>
                </div>
                <div class="ws-ribbon-group-label">Пользователи</div>
            </div>
        </div>
    </div>
</div>

@code {
    private const string ClassName = "WebShelf.Components.Shared.RibbonMenu";

    /// <summary>
    /// Отображаемое имя текущего пользователя (в заголовке ленты).
    /// </summary>
    [Parameter]
    public string CurrentUser { get; set; } = string.Empty;

    /// <summary>
    /// Отображаемое имя роли текущего пользователя — в квадратных скобках
    /// между логином и кнопкой «Выйти» (например: ivanov [Администратор] Выйти).
    /// Пусто, если роль неизвестна — индикатор не отображается.
    /// </summary>
    [Parameter]
    public string CurrentRole { get; set; } = string.Empty;

    /// <summary>
    /// Уникальный id корневого элемента ленты для JS interop.
    /// </summary>
    private string RibbonElementId { get; } = "ws-ribbon-" + Guid.NewGuid().ToString("N")[..8];

    /// <summary>
    /// true после успешного вызова init модуля.
    /// </summary>
    private bool _jsInitialized;

    /// <summary>
    /// Ссылка на ES-модуль RibbonMenu.razor.js (JS-isolation):
    /// импортируется один раз за цепочку, функции вызываются через него.
    /// </summary>
    private IJSObjectReference? _module;

    /// <summary>
    /// Выход через fetch POST /account/logout с antiforgery-токеном
    /// (реализация — logout в RibbonMenu.razor.js): сервер сбрасывает cookie,
    /// затем браузер переходит на /entry. GET-эндпоинт выхода на сервере отключён
    /// (защита от logout-CSRF), поэтому fallback-перехода по GET нет:
    /// без JS interop выход невозможен (приложение целиком требует JS).
    /// </summary>
    private async Task LogoutAsync()
    {
        try
        {
            if (_module is not null)
            {
                await _module.InvokeVoidAsync("logout");
            }
            else
            {
                Log.Error("JS-модуль ленты не импортирован при выходе. Class={Class}, Method={Method}", ClassName, nameof(LogoutAsync));
            }
        }
        catch (JSDisconnectedException)
        {
            // Цепь Blazor разорвана — пользователь увидит экран переподключения.
        }
        catch (InvalidOperationException)
        {
            // JS interop недоступен (статический prerender): клики в этом режиме невозможны.
            Log.Error("JS interop недоступен при выходе. Class={Class}, Method={Method}", ClassName, nameof(LogoutAsync));
        }
        catch (Exception ex)
        {
            Log.Error(ex, "Исключение в {Class}.{Method}", ClassName, nameof(LogoutAsync));
        }
    }

    /// <summary>
    /// После первого интерактивного рендера импортирует JS-модуль
    /// и инициализирует переключение вкладок.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (!firstRender || _jsInitialized)
            {
                return;
            }

            _module = await Js.InvokeAsync<IJSObjectReference>("import", "./Components/Shared/RibbonMenu.razor.js");
            await _module.InvokeVoidAsync("init", RibbonElementId);
            _jsInitialized = true;
        }
        catch (JSDisconnectedException)
        {
            // Цепь Blazor разорвана.
        }
        catch (InvalidOperationException)
        {
            // Статический prerender — interop недоступен.
        }
        catch (Exception ex)
        {
            Log.Error(ex, "Исключение в {Class}.{Method}", ClassName, nameof(OnAfterRenderAsync));
        }
    }

    /// <summary>
    /// Освобождает JS-ресурсы ленты (обработчики и ссылку на модуль).
    /// </summary>
    public async ValueTask DisposeAsync()
    {
        if (_module is null)
        {
            return;
        }

        try
        {
            if (_jsInitialized)
            {
                await _module.InvokeVoidAsync("dispose", RibbonElementId);
            }
        }
        catch (JSDisconnectedException)
        {
            // Цепь уже закрыта.
        }
        catch (InvalidOperationException)
        {
            // Статический контекст.
        }
        catch (Exception ex)
        {
            Log.Error(ex, "Исключение в {Class}.{Method}", ClassName, nameof(DisposeAsync));
        }
        finally
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
            catch (InvalidOperationException)
            {
            }

            _module = null;
            _jsInitialized = false;
        }
    }
}
